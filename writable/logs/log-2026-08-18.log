                        r.num_rec,
                        rd.prev_billed_index,
                        rd.curr_billed_index,
                        NVL((MAX(ac.cte_apa) KEEP (DENSE_RANK LAST ORDER BY ac.f_lect, ac.f_actual) OVER (PARTITION BY r.num_rec)), 1) AS coeff
                    FROM cmsreport.tmp_ref_confacresu t
