#--------------------------------------------------------------------
# Example Environment Configuration file
#
# This file can be used as a starting point for your own
# custom .env files, and contains most of the possible settings
# available in a default install.
#
# By default, all of the settings are commented out. If you want
# to override the setting, you must un-comment it by removing the '#'
# at the beginning of the line.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

# app.baseURL = ''
# If you have trouble with `.`, you could also use `_`.
app.baseURL = 'http://localhost:3000/'
# app.forceGlobalSecureRequests = false
# app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

# database.default.hostname = localhost
# database.default.database = ci4
# database.default.username = root
# database.default.password = root
# database.default.DBDriver = MySQLi
# database.default.DBPrefix =
# database.default.port = 3306

# Do not commit production values. Configure these locally or through deployment secrets.
# Oracle OCI8: configure either a TNS alias/Easy Connect string in DSN, or
# hostname + port + database (the Oracle SERVICE_NAME). Do not commit secrets.
# Use the managed TNS alias rather than the direct listener address.
database.oracle.DSN = 'cmsprod'
database.oracle.username = 'CMS_RFC'
database.oracle.password = 'CMS_2016_RFC'
# database.oracle.DSN =
# database.oracle.pConnect = false
# database.oracle.DBDebug = false

ldap.host = 'ldap://10.250.90.8'
ldap.port = 389
ldap.baseDn = 'OU=Cameroon,DC=camlight,DC=cm'
ldap.domain = 'camlight.cm'
# ldap.importManagerGroup = 'CN=Import Managers,OU=Groups,DC=example,DC=com'

# Groupe(s) AD donnant accès à Administration > Journal d'audit (AdminAuditFilter).
# DN complet ou simple nom de groupe (CN) ; plusieurs groupes séparés par ";".
# Groupe AD officiel MyMemo (décision fonctionnelle du 19/08/2026) : un membre
# de ce groupe a les droits administrateur MyMemo. Ni l'ancien groupe
# historique "Admins" ni "ApplicationsAdmins" (utilisé pendant le diagnostic
# précédent, groupe applicatif générique non spécifique à MyMemo) ne doivent
# plus donner ces droits.
ldap.adminGroups = 'MyMemoAdmins'

# Groupe(s) AD autorisant l'usage fonctionnel de MyMemo (import, génération,
# export) pour un utilisateur authentifié. Même format que ldap.adminGroups.
# Un membre de ldap.adminGroups a toujours ces droits, même s'il n'apparaît
# pas explicitement dans ldap.userGroups (voir AuthentificationController).
ldap.userGroups = 'MyMemoUsers'

# If you use MySQLi as tests, first update the values of Config\Database::$tests.
# database.tests.hostname = localhost
# database.tests.database = ci4_test
# database.tests.username = root
# database.tests.password = root
# database.tests.DBDriver = MySQLi
# database.tests.DBPrefix =
# database.tests.charset = utf8mb4
# database.tests.DBCollat = utf8mb4_general_ci
# database.tests.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------

# encryption.key =

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

# session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
# session.savePath = null

# Durée maximale d'inactivité (en secondes)
SESSION_TIMEOUT = 900

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

# logger.threshold = 4
